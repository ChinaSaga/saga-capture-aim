# 源码统一按 LF 入库、检出时按本机习惯（Windows 下即 CRLF）
* text=auto

# 必须保持 LF 的脚本
*.sh text eol=lf

# 二进制
# ⚠ 驱动文件一个字节都不能被 git 改写（INF 也在签名目录的校验范围内），
#   必须整目录按 binary 处理，否则 CAT 校验会失败、静默安装被驱动签名强制拦下
src/drv/** binary
*.dll binary
*.exe binary
*.pdb binary
*.png binary
*.jpg binary
*.ico binary
*.bin binary

# VS 工程文件容易产生冲突，合并时取并集
*.sln merge=union

# 中文文件名/路径不要被转义显示
*.md -text
