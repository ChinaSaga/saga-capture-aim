<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- SDKs live beside this project. See tools/install_dependencies.ps1. -->
  <PropertyGroup>
    <SagaDependenciesRoot>$(MSBuildThisFileDirectory).deps\</SagaDependenciesRoot>
    <SagaNcnnVersion>20260526</SagaNcnnVersion>
    <SagaNcnnDir>$(SagaDependenciesRoot)ncnn-$(SagaNcnnVersion)\x64</SagaNcnnDir>
    <SagaOpenCvVersion>5.0.0</SagaOpenCvVersion>
    <SagaOpenCvDir>$(SagaDependenciesRoot)opencv-$(SagaOpenCvVersion)\opencv\build</SagaOpenCvDir>
    <SagaOpenCvLibrary>opencv_world500.lib</SagaOpenCvLibrary>
    <SagaOpenCvRuntime>opencv_world500.dll</SagaOpenCvRuntime>
    <SagaOrtVersion>1.30.0</SagaOrtVersion>
    <SagaOrtDir>$(SagaDependenciesRoot)onnxruntime-dml-$(SagaOrtVersion)</SagaOrtDir>
    <SagaDirectMLVersion>1.15.4</SagaDirectMLVersion>
    <SagaDirectMLDir>$(SagaDependenciesRoot)directml-$(SagaDirectMLVersion)-x64</SagaDirectMLDir>
    <SagaTensorRtVersion>11.3.0.99</SagaTensorRtVersion>
    <SagaTensorRtDir>$(SagaDependenciesRoot)tensorrt-$(SagaTensorRtVersion)</SagaTensorRtDir>
    <SagaCudaVersion>13.4</SagaCudaVersion>
    <SagaCudaDir Condition="'$(SagaCudaDir)' == ''">$(CUDA_PATH)</SagaCudaDir>
    <SagaCudaDir Condition="'$(SagaCudaDir)' == ''">$(SagaDependenciesRoot)cuda-headers-13.0\cuda_cudart-windows-x86_64-13.0.96-archive</SagaCudaDir>
    <SagaCudaRuntimeDir Condition="'$(SagaCudaRuntimeDir)' == '' and Exists('$(SagaCudaDir)\bin\x64\cudart64_13.dll') and Exists('$(SagaCudaDir)\bin\x64\cublas64_13.dll')">$(SagaCudaDir)\bin\x64</SagaCudaRuntimeDir>
    <SagaCudaRuntimeDir Condition="'$(SagaCudaRuntimeDir)' == '' and Exists('$(SagaCudaDir)\bin\cudart64_13.dll') and Exists('$(SagaCudaDir)\bin\cublas64_13.dll')">$(SagaCudaDir)\bin</SagaCudaRuntimeDir>
    <SagaCudaRuntimeDir Condition="'$(SagaCudaRuntimeDir)' == ''">$(SagaDependenciesRoot)cuda-runtime-13.4</SagaCudaRuntimeDir>
  </PropertyGroup>
</Project>
