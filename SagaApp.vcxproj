<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   SagaApp.vcxproj —— 唯一的工程（64 位 / x64 / Release）

   历史：原来是两个工程
     · Saga.vcxproj       -> Saga.dll   （采集卡 + NCNN/ONNX + Makcu 串口，源码在 ConsoleApplication2\）
     · SagaApp.vcxproj    -> SagaApp.exe（易语言主程序的 C++ 翻写版，源码在 SagaApp\）
   现在：两者合并为一个 Application 工程，源码统一在 src\，
        产物 SagaApp.exe **运行时不再需要 Saga.dll**。
        原 Saga.vcxproj 的第三方库路径 / AVX2 / fp:fast 等设置已并入本文件。

   ⚠ 字符集：全工程统一 /source-charset:utf-8 /execution-charset:.936
     （源码存 UTF-8，中文常量编成 GBK —— 全程序"内部 GBK、对外 UTF-8"的设计靠这个，
      不要改成 /utf-8）
   ============================================================================
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
