  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>false</SDLCheck><BufferSecurityCheck>false</BufferSecurityCheck><ControlFlowGuard>false</ControlFlowGuard>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;NDEBUG;_WINDOWS;_CRT_SECURE_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;ASIO_USE_TS_EXECUTOR_AS_DEFAULT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 不开 /permissive-：原 DLL 工程也没开，asio 那套模板在老工程里没验证过 -->
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)src\Makcu\cat\src;$(ProjectDir)src\Makcu\cat\include;$(ProjectDir)src\Makcu\include;D:\NCNN\x64\include;D:\NCNN\x64\include\ncnn;D:\DirectMLx64onnx\ort-dml-x64-1.24.4\include;D:\openCV\build\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <!-- Makcu 源码里有 try/catch，必须开异常处理；原 DLL 工程没开（C4530，异常时析构不执行） -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <!-- Mouse.cpp / NCNN.cpp 用了 AVX2+FMA 内联指令 -->
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <FloatingPointModel>Fast</FloatingPointModel>
      <Optimization>MaxSpeed</Optimization>
      <!-- /Ob3 通过 AdditionalOptions 启用，避免显式 /Ob2 与其重复。 -->
      <InlineFunctionExpansion>Default</InlineFunctionExpansion>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <OmitFramePointers>true</OmitFramePointers>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:.936 %(AdditionalOptions) /Ob3</AdditionalOptions>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>D:\NCNN\x64\lib;D:\openCV\build\x64\vc16\lib;D:\DirectMLx64onnx\ort-dml-x64-1.24.4\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ncnn.lib;opencv_world4120.lib;onnxruntime.lib;strmiids.lib;winmm.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <!-- 提权清单：装 Makcu(CH343) 驱动需要管理员，见 src\app.manifest。
           注意别再往 DriverRes.rc 里塞 RT_MANIFEST，否则会出现两份清单，
           链接报“资源重复。类型: MANIFEST”(CVT1100)。 -->
      <EnableUAC>true</EnableUAC>
      <UACExecutionLevel>RequireAdministrator</UACExecutionLevel>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;NDEBUG;_ITERATOR_DEBUG_LEVEL=0;_WINDOWS;_CRT_SECURE_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;ASIO_USE_TS_EXECUTOR_AS_DEFAULT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)src\Makcu\cat\src;$(ProjectDir)src\Makcu\cat\include;$(ProjectDir)src\Makcu\include;D:\NCNN\x64\include;D:\NCNN\x64\include\ncnn;D:\DirectMLx64onnx\ort-dml-x64-1.24.4\include;D:\openCV\build\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExceptionHandling>Sync</ExceptionHandling>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <AdditionalOptions>/source-charset:utf-8 /execution-charset:.936 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>D:\NCNN\x64\lib;D:\openCV\build\x64\vc16\lib;D:\DirectMLx64onnx\ort-dml-x64-1.24.4\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ncnn.lib;opencv_world4120.lib;onnxruntime.lib;strmiids.lib;winmm.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableUAC>true</EnableUAC>
      <UACExecutionLevel>RequireAdministrator</UACExecutionLevel>
    </Link>
  </ItemDefinitionGroup>
